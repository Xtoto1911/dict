	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"if (!pm.collectionVariables.get(\"baseUrl\")) {\r",
					"    pm.collectionVariables.set(\"baseUrl\", \"http://localhost:8080\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"dictionaryId\")) {\r",
					"    pm.collectionVariables.set(\"dictionaryId\", \"\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"entryId\")) {\r",
					"    pm.collectionVariables.set(\"entryId\", \"\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"searchQuery\")) {\r",
					"    pm.collectionVariables.set(\"searchQuery\", \"qwer\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"searchType\")) {\r",
					"    pm.collectionVariables.set(\"searchType\", \"latin\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"newKey\")) {\r",
					"    pm.collectionVariables.set(\"newKey\", \"asdf\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"newValue\")) {\r",
					"    pm.collectionVariables.set(\"newValue\", \"новоеслово\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"newType\")) {\r",
					"    pm.collectionVariables.set(\"newType\", \"latin\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"updateKey\")) {\r",
					"    pm.collectionVariables.set(\"updateKey\", \"zxcv\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"updateValue\")) {\r",
					"    pm.collectionVariables.set(\"updateValue\", \"обновленноеслово\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"updateType\")) {\r",
					"    pm.collectionVariables.set(\"updateType\", \"latin\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"valueToDelete\")) {\r",
					"    pm.collectionVariables.set(\"valueToDelete\", \"словодляудаления\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"dictionaryType\")) {\r",
					"    pm.collectionVariables.set(\"dictionaryType\", \"latin\");\r",
					"}\r",
					"\r",
					"if (!pm.collectionVariables.get(\"mockData\")) {\r",
					"    pm.collectionVariables.set(\"mockData\", JSON.stringify({\r",
					"        \"latin\": {\r",
					"            \"key\": \"qwer\",\r",
					"            \"value\": \"йцук\",\r",
					"            \"type\": \"latin\"\r",
					"        },\r",
					"        \"num\": {\r",
					"            \"key\": \"12345\",\r",
					"            \"value\": \"йцуке\",\r",
					"            \"type\": \"num\"\r",
					"        }\r",
					"    }));\r",
					"}"
				]
			}
